gitter = []

with open("inputTag6.txt") as file:
    for line in file:
        gitter.append(line.strip())

for z in range(len(gitter)):
    for s in range(len(gitter[0])):
        if gitter[z][s] == "^":
            zeile = z
            spalte = s

richtungen = [(-1, 0), (0, 1), (1, 0), (0, -1)]
richtung = 0

besucht = set()
besucht.add((zeile, spalte))

while True:
    dz, ds = richtungen[richtung]
    naechste_zeile = zeile + dz
    naechste_spalte = spalte + ds

    if not (0 <= naechste_zeile < len(gitter) and 0 <= naechste_spalte < len(gitter[0])):
        break

    if gitter[naechste_zeile][naechste_spalte] == "#":
        richtung = (richtung + 1) % 4
    else:
        zeile = naechste_zeile
        spalte = naechste_spalte
        besucht.add((zeile, spalte))

print(len(besucht))