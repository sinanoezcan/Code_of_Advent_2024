                    nz = z + schritt * dz
                    ns = s + schritt * ds
                    if not (0 <= nz < len(gitter) and 0 <= ns < len(gitter[0])):
                        gefunden = False
                        break
                    if gitter[nz][ns] != "MAS"[schritt - 1]:
                        gefunden = False
                        break
                if gefunden: 
                    anzahl += 1
print(anzahl)